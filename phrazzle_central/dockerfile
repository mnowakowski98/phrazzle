FROM dart:stable AS build

RUN apt-get update && apt-get install -y curl build-essential && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
RUN rustup install 1.94

WORKDIR /app
COPY ./libsql_dart ./libsql_dart
COPY ./drift_libsql ./drift_libsql
COPY ./phrazzle_lib ./phrazzle_lib
COPY ./phrazzle_central ./phrazzle_central

WORKDIR /app/phrazzle_central
RUN dart pub get --no-example
RUN dart build cli --verbose -t bin/phrazzle_central.dart -o /app/server

RUN LIBGCC=$(find / -name libgcc_s.so.1 -path '*lib*' | head -n 1) \
    && mkdir -p /out$(dirname $LIBGCC) \
    && cp $LIBGCC /out$LIBGCC

# FROM debian:bookworm-slim
FROM scratch

ENV _LIB_DIRECTORY_PATH=/app/lib/

COPY --from=build /runtime/ /
COPY --from=build /out/usr/ /
COPY --chmod=+x --from=build /app/server/bundle/ /app/

ARG PORT
EXPOSE $PORT
CMD ["/app/bin/phrazzle_central"]
